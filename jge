<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <title>Pokémon: Zerya Serüveni</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #1a1a1a; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; color: white; overflow: hidden; }
        #game-container { background: #333; padding: 25px; border-radius: 20px; box-shadow: 0 0 50px rgba(0,0,0,0.8); text-align: center; width: 450px; border: 4px solid #f1c40f; position: relative; }
        
        /* Ekranlar */
        .screen { display: none; }
        .active { display: block; }

        /* Giriş ve Seçim */
        .start-btn, .select-btn { background: #2ecc71; color: white; border: none; padding: 15px 30px; font-size: 20px; border-radius: 10px; cursor: pointer; margin: 10px; transition: 0.2s; }
        .start-btn:hover { background: #27ae60; transform: scale(1.05); }
        .pokemon-options { display: flex; justify-content: center; gap: 10px; margin-top: 20px; }

        /* Savaş Alanı */
        .battle-area { display: flex; justify-content: space-between; margin: 20px 0; }
        .unit-box { background: #444; padding: 10px; border-radius: 10px; width: 45%; border: 2px solid #555; transition: 0.3s; }
        .hp-bar-bg { background: #222; height: 10px; border-radius: 5px; margin: 8px 0; overflow: hidden; }
        .hp-fill { background: #2ecc71; height: 100%; width: 100%; transition: width 0.4s; }
        .xp-fill { background: #3498db; height: 100%; width: 0%; transition: width 0.4s; }
        
        button#atk-btn { background: #e74c3c; color: white; border: none; padding: 15px; width: 100%; font-size: 18px; font-weight: bold; border-radius: 10px; cursor: pointer; }
        #log { margin-top: 15px; font-size: 14px; min-height: 50px; border-top: 1px solid #555; padding-top: 10px; color: #f1c40f; }
        
        /* Animasyonlar */
        .shake { animation: shake 0.2s; }
        @keyframes shake { 0% { transform: translate(1px, 1px); } 20% { transform: translate(-3px, 0); } 40% { transform: translate(3px, 0); } 100% { transform: translate(0, 0); } }
        .evolve-anim { animation: flash 0.4s 4; }
        @keyframes flash { 0%, 100% { background: #444; } 50% { background: #fff; transform: scale(1.1); } }
    </style>
</head>
<body>

<div id="game-container">
    <div id="start-screen" class="screen active">
        <h1>POKÉMON</h1>
        <p>Zerya Bölgesine Hoş Geldin</p>
        <button class="start-btn" onclick="showScreen('select-screen')">BAŞLA</button>
    </div>

    <div id="select-screen" class="screen">
        <h3>Başlangıç Pokémonunu Seç</h3>
        <div class="pokemon-options">
            <button class="select-btn" style="background:#27ae60" onclick="choosePokemon('Floratup', 'Çimen')">Floratup</button>
            <button class="select-btn" style="background:#e67e22" onclick="choosePokemon('Ignicub', 'Ateş')">Ignicub</button>
            <button class="select-btn" style="background:#2980b9" onclick="choosePokemon('Bubblin', 'Su')">Bubblin</button>
        </div>
    </div>

    <div id="battle-screen" class="screen">
        <h2 id="stage-title">Bölüm 1</h2>
        <div class="battle-area">
            <div id="player-card" class="unit-box">
                <div id="p-name" style="font-weight: bold;">---</div>
                <div style="font-size: 11px;">Lv. <span id="p-lv">1</span></div>
                <div class="hp-bar-bg"><div id="p-hp-fill" class="hp-fill"></div></div>
                <div class="hp-bar-bg"><div id="p-xp-fill" class="xp-fill"></div></div>
            </div>
            <div id="enemy-card" class="unit-box" style="border-color: #e74c3c;">
                <div id="e-name" style="font-weight: bold;">---</div>
                <div id="e-diff" style="font-size: 11px; color: #aaa;">---</div>
                <div class="hp-bar-bg"><div id="e-hp-fill" class="hp-fill"></div></div>
            </div>
        </div>
        <button id="atk-btn" onclick="playTurn()">SALDIR!</button>
        <div id="log">Rakibine ilk hamleni yap!</div>
    </div>
</div>

<script>
    let player = { name: "", type: "", lv: 1, hp: 100, maxHp: 100, atk: 25, xp: 0, evolved: false };
    let enemies = [
        { name: "Vahşi Pidgey", hp: 60, maxHp: 60, atk: 12, diff: "Kolay" },
        { name: "Kızgın Rattata", hp: 110, maxHp: 110, atk: 18, diff: "Normal" },
        { name: "Dev Onix", hp: 300, maxHp: 300, atk: 30, diff: "ZOR" },
        { name: "Karanlık MEWTWO", hp: 700, maxHp: 700, atk: 55, diff: "EFSANEVİ" }
    ];
    let currentEnemyIndex = 0;

    function showScreen(id) {
        document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
        document.getElementById(id).classList.add('active');
    }

    function choosePokemon(name, type) {
        player.name = name;
        player.type = type;
        document.getElementById('p-name').innerText = name;
        updateUI();
        showScreen('battle-screen');
    }

    function playTurn() {
        let enemy = enemies[currentEnemyIndex];
        const log = document.getElementById('log');
        const eCard = document.getElementById('enemy-card');
        const pCard = document.getElementById('player-card');

        // Oyuncu Saldırısı
        let dmg = Math.floor(Math.random() * 10) + player.atk;
        enemy.hp -= dmg;
        eCard.classList.add('shake');
        setTimeout(() => eCard.classList.remove('shake'), 200);

        if (enemy.hp <= 0) {
            enemy.hp = 0;
            updateUI();
            log.innerText = `${enemy.name} yenildi! Tecrübe kazandın.`;
            setTimeout(nextEnemy, 1000);
            return;
        }

        // Düşman Saldırısı
        let eDmg = Math.floor(Math.random() * 5) + enemy.atk;
        player.hp -= eDmg;
        pCard.classList.add('shake');
        setTimeout(() => pCard.classList.remove('shake'), 200);

        if (player.hp <= 0) {
            player.hp = 0;
            log.innerText = "Pokémonun nakavt oldu! Yenildin...";
            document.getElementById('atk-btn').disabled = true;
        }

        log.innerText = `${player.name} ${dmg} hasar vurdu. ${enemy.name} ${eDmg} hasar ile karşılık verdi!`;
        updateUI();
    }

    function nextEnemy() {
        currentEnemyIndex++;
        player.xp += 50;
        player.hp = player.maxHp;

        if (player.xp >= 100 && !player.evolved) triggerEvolution();

        if (currentEnemyIndex < enemies.length) {
            document.getElementById('stage-title').innerText = `Bölüm ${currentEnemyIndex + 1}`;
            updateUI();
        } else {
            document.getElementById('log').innerText = "Tebrikler! Zerya Şampiyonu oldun!";
            document.getElementById('atk-btn').style.display = "none";
        }
    }

    function triggerEvolution() {
        player.evolved = true;
        let oldName = player.name;
        player.name = (player.type === "Ateş") ? "INFERLION" : (player.type === "Su") ? "AQUABUNNY" : "TERRAGOAT";
        player.atk += 35;
        player.maxHp += 150;
        player.hp = player.maxHp;
        player.lv = 2;
        
        const pCard = document.getElementById('player-card');
        pCard.classList.add('evolve-anim');
        setTimeout(() => {
            pCard.classList.remove('evolve-anim');
            document.getElementById('p-name').innerText = player.name;
            document.getElementById('p-name').style.color = "#f1c40f";
            alert(`${oldName} evrim geçirdi ve ${player.name} oldu!`);
        }, 1600);
    }

    function updateUI() {
        let enemy = enemies[currentEnemyIndex] || enemies[enemies.length-1];
        document.getElementById('p-hp-fill').style.width = (player.hp / player.maxHp * 100) + "%";
        document.getElementById('p-xp-fill').style.width = (player.xp % 100) + "%";
        document.getElementById('p-lv').innerText = player.lv;
        document.getElementById('e-name').innerText = enemy.name;
        document.getElementById('e-diff').innerText = enemy.diff;
        document.getElementById('e-hp-fill').style.width = (enemy.hp / enemy.maxHp * 100) + "%";
    }
</script>
</body>
</html>
